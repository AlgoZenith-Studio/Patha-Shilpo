# Device config for wireless ADB — local to each developer, never committed.
#
# Setup on your phone:
#   Settings -> Developer options -> Wireless debugging -> ON
#   -> "Pair device with pairing code"
#
# You'll see TWO different IP:port pairs — they are not the same port:
#   1. The pairing dialog shows a PAIRING port + a 6-digit code
#   2. The main Wireless debugging screen shows a separate CONNECT port
#
# Fill in your own values below, then run: ./scripts/wireless_connect.sh
# (or scripts\wireless_connect.ps1 on Windows). Both ports change every time
# you reopen the pairing dialog or the phone reconnects — update this file
# each session, it is not a one-time setup.

# From the "Pair device with pairing code" dialog
ADB_PAIR_HOST=192.168.1.3
ADB_PAIR_PORT=46127
ADB_PAIR_CODE=301014

# From the main Wireless debugging screen ("IP address & Port")
ADB_CONNECT_HOST=192.168.1.3
ADB_CONNECT_PORT=41011

# Path to platform-tools/adb on your machine. Defaults below cover the
# standard Android Studio install locations on each OS if left blank.
ANDROID_SDK_ROOT=

# Android application id — must match android/app/build.gradle.kts, only
# change this if that file changes too.
APP_ID=com.example.pathashilpa

# ---------------------------------------------------------------------------
# App runtime config - bundled into the app itself (see pubspec.yaml assets),
# not just used by these scripts. This is a plain LAN IP, not a secret, so
# shipping it as an asset is fine for local dev builds. A release build
# pointed at a real production backend needs a different mechanism - not set
# up yet.
#
# Use your machine's LAN IP (the one your phone can actually reach), NOT
# 127.0.0.1/localhost - the phone is a separate device on the network.
# An Android emulator (not a real device) should instead use 10.0.2.2, which
# is the emulator's alias for the host machine's localhost.
BACKEND_URL=http://192.168.1.2:8000
